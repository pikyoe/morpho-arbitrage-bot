{
  "name": "morpho-arbitrage-bot",
  "version": "2.0.0",
  "description": "Morpho Flash Loan Arbitrage Bot for Base Mainnet",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx src/index.ts",
    "mainnet": "ENV_FILE=.env.mainnet tsx src/index.ts",
    "sepolia": "ENV_FILE=.env.sepolia tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "compile": "hardhat compile",
    "test": "hardhat test"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "web3": "^4.16.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.15",
    "@typechain/ethers-v6": "^0.5.1",
    "@types/node": "^24.13.3",
    "chai": "^6.2.2",
    "hardhat": "^3.11.0",
    "mocha": "^11.7.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typechain": "^8.3.2",
    "typescript": "^5.9.2"
  }
}
