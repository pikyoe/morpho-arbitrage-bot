# Token Whitelist for Triangle Discovery (comma-separated addresses)
# Format: TOKEN_WHITELIST=0xaddress1,0xaddress2,0xaddress3
# Example: TOKEN_WHITELIST=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913,0x4200000000000000000000000000000000000006,0x50c5725949A6F0c72E6C4a641F24049A917DB0Cb
# If not set, will scan all tokens (less safe)
TOKEN_WHITELIST=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913,0x4200000000000000000000000000000000000006,0x50c5725949A6F0c72E6C4a641F24049A917DB0Cb,0x94018181425D27f340A398dA1Ed61075E0229c01,0xfde4C96c8593536E31F229EA8f91900252513060,0xD0d3EbC2fB36F203F4D2F33C40f4812B7b3E154e,0xc1cA2b7e418d4d7B2974A5C79b04892e40b14cE7,0x0f5316C12D8a3EE18aa691E3929342d02dB76e0D,0x2e7B6d1B766E5Db5b76623A60E095fDB334b59f9,0xb9D6968946Ab75F9249267D4b1AaB6C6096D6f41,0x2Ae3F1ec7F1F50155CFCE79f6584c5f85ac146e3,0x5401a78dF51d424B46798b9A4C68b835a951d3A1,0x049067F81ec89E7f07Fe5eAB8B311548C12B6348,0x04C0599A5B4885f8A522002a18Ce625DeA0147f1,0x8b085865C2e59476d5973eD44aEA4515C7B37319,0x7D703E041c50B6b4A3E8a3b48F5E8E9E7e9c0f4A,0x0b3e328455c4059EEb9e3f84b5543F74E24e7E1b,0xcbb7c0000ab88b473b1f5afd9ef808440eed33bf

# Bridge Tokens for Arbitrage Opportunities (Valid checksum addresses from BaseScan)
USDe_ADDRESS=0x5d3a1Ff2b6BAb83b63cd9AD0787074081a52ef34
RLUSD_ADDRESS=0x8d58C0C60B8D6b88Fa98B291a646dB34d0F98258
MORPHO_TOKEN_ADDRESS=0xBAa5CC21fd487B8Fcc2F632f3F4E8D37262a0842

# 1inch API Configuration (Fallback)
INCH_API_KEY=your_1inch_api_key_here
INCH_API_BASE_URL=https://api.1inch.dev/swap/v6.0/8453

# 0x API Configuration (Primary)
ZEROX_API_KEY=your_0x_api_key_here
ZEROX_API_URL=https://api.0x.org

# PancakeSwap Configuration (Base Chain)
PANCAKESWAP_FACTORY_ADDRESS=0x0BFbCF9fa4f9C56B0F40a671Ad40E0805A091865
PANCAKESWAP_QUOTER_ADDRESS=0xB048Bbc1Ee6b733FFfCFb9e9CeF7375518e25997
PANCAKESWAP_ROUTER_ADDRESS=0x1b81D678ffb9C0263b24A97847620C99d213eB14

# Deployed Contract Addresses (fill after deployment)
MORPHO_FLASHLOAN_V2_ADDRESS=0xDEPLOYED_MORPHO_FLASHLOAN_ADDRESS
ARBITRAGE_ENGINE_V2_ADDRESS=0xDEPLOYED_ENGINE_ADDRESS
UNISWAP_ADAPTER_V2_ADDRESS=0xDEPLOYED_UNISWAP_ADAPTER_ADDRESS
SUSHISWAP_ADAPTER_V2_ADDRESS=0xDEPLOYED_SUSHISWAP_ADAPTER_ADDRESS
PANCAKESWAP_ADAPTER_V2_ADDRESS=0xDEPLOYED_PANCAKESWAP_ADAPTER_ADDRESS
AERODROME_ADAPTER_V2_ADDRESS=0xDEPLOYED_AERODROME_ADAPTER_ADDRESS

# Watcher / Execution Configuration (watchAndExecute.ts & watchAndExecuteTargeted.ts)
# Execution is FAIL-CLOSED: must be explicitly set to true to allow transactions.
WATCH_ENABLE_EXECUTION=true
# WATCH_MODE: single | all | list
WATCH_MODE=list
# WATCH_PAIRS format: "0xAAA,0xBBB;0xCCC,0xDDD" (used when WATCH_MODE=list)
WATCH_PAIRS=
WATCH_TEST_USD=500
WATCH_MAX_LOAN_USD=10000
WATCH_POLL_MS=5000
SPREAD_THRESHOLD_PCT=0.2
MIN_NET_PROFIT_USD=1
SLIPPAGE_PCT=0.1
# Fraction of the quoted profit kept as the on-chain minProfit floor (10-90, default 50).
# A lower value tolerates price drift between quote and execution; 100 would revert
# InsufficientProfit on any adverse tick.
MIN_PROFIT_BUFFER_PCT=50
# Comma-separated allowlist of flash-loan tokens (Morpho flash loans must have a 0
# borrow fee on the flashed token or repayment reverts). Empty = unrestricted.
FLASH_TOKEN_ALLOWLIST=
# Subgraph-first pool cache; falls back to factory RPC when the subgraph is thin.
POOL_RPC_FALLBACK=false
MIN_LIQUIDITY_USD=10000
MIN_DEX_VARIETY=2
MAX_PAIRS_PER_SCAN=200
TOP_N_CANDIDATES=5
SUBGRAPH_POOL_LIMIT=20

# Optional Configuration
SAMPLE_AUTHORIZED_ADDRESS=0xAUTHORIZED_ADDRESS_OPTIONAL

# Flashbots MEV Protection Configuration
FLASHBOTS_ENABLED=true
FLASHBOTS_RELAY_URL=https://relay.flashbots.net
FLASHBOTS_MIN_PROFIT_USD=10.0
FLASHBOTS_MAX_RETRIES=3
FLASHBOTS_FALLBACK_TO_PUBLIC=true
