# Copy this file to .env.mainnet or .env.sepolia and fill in the actual values
# NEVER commit files with actual private keys or sensitive data

# Wallet Configuration
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# RPC Configuration
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Morpho Configuration
MORPHO_ADDRESS=0xMORPHO_BLUE_ADDRESS

# Uniswap Configuration
UNISWAP_FACTORY_ADDRESS=0xUNISWAP_FACTORY_ADDRESS
UNISWAP_ROUTER_ADDRESS=0xUNISWAP_ROUTER_ADDRESS
UNISWAP_QUOTER_ADDRESS=0xUNISWAP_QUOTER_ADDRESS

# Aerodrome Configuration
AERODROME_FACTORY_ADDRESS=0xAERODROME_FACTORY_ADDRESS
AERODROME_ROUTER=0xAERODROME_ROUTER_ADDRESS

# Token Addresses
WETH_ADDRESS=0x4200000000000000000000000000000000000006
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
AERO_ADDRESS=0x940181a94A35A4569E4529A3CDfB74e38FD98631
CBBTC_ADDRESS=0xcbB7C0000aB88B473b1f5aFd9ef808440eed33Bf
CBETH_ADDRESS=0x2Ae3F1Ec7F1F5012CFEab0185bfc7aa3cf0DEc22

# Deployed Contract Addresses (fill after deployment)
MORPHO_FLASHLOAN_V2_ADDRESS=0xDEPLOYED_MORPHO_FLASHLOAN_ADDRESS
ARBITRAGE_ENGINE_V2_ADDRESS=0xDEPLOYED_ENGINE_ADDRESS
UNISWAP_ADAPTER_V2_ADDRESS=0xDEPLOYED_UNISWAP_ADAPTER_ADDRESS
AERODROME_ADAPTER_V2_ADDRESS=0xDEPLOYED_AERODROME_ADAPTER_ADDRESS

# Optional Configuration
SAMPLE_AUTHORIZED_ADDRESS=0xAUTHORIZED_ADDRESS_OPTIONAL
