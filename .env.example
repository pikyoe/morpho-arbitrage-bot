# Copy this file to .env.mainnet or .env.sepolia and fill in the actual values
# NEVER commit files with actual private keys or sensitive data

# Wallet Configuration
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# RPC Configuration
BASE_RPC_URL=https://mainnet.base.org
BASE_WS_RPC_URL=wss://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_WS_RPC_URL=wss://sepolia.base.org

# Multi-RPC Configuration (for better rate limit handling)
BASE_RPC_URL_1=https://mainnet.base.org
BASE_RPC_URL_2=https://rpc.ankr.com/base

# Morpho Configuration
MORPHO_ADDRESS=0xMORPHO_BLUE_ADDRESS

